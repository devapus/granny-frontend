# ----------------------------------------------------------------
# House of Memories – frontend
# Copy to `.env` for local development. On Vercel set these in Project Settings.
# ----------------------------------------------------------------

# API base URL as seen by the browser (include /api/v1, no trailing slash).
#
# Local (recommended): same-origin path — Vite proxies to VITE_DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
#
# Production with a separate API domain (example):
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1

# Where the Vite dev/preview proxy sends /api/* (only used when VITE_API_BASE_URL is a path).
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
